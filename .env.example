# ── MindMate AI server ─────────────────────────────────────────
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# ── Ollama ─────────────────────────────────────────────────────
# The fine-tuned companion model from the original project.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=phi-mindmate
# Optional embedding model. If unavailable, MindMate falls back to
# a local lexical retriever with no loss of core functionality.
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_MS=60000

# ── Behaviour ──────────────────────────────────────────────────
# Set DATA_DIR to keep wellness data outside the app folder.
# DATA_DIR=./data
MAX_CONTEXT_MESSAGES=12
# Set to false to disable import of legacy data on first boot.
SEED_LEGACY=true
